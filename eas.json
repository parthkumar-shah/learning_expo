{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
       "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
   "development-release": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "gradleCommand": ":app:assembleRelease",
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
       "environment": "preview",
       "android": {
        "gradleCommand": ":app:assembleRelease",
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "production": {
       "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "cli": {
    "version": ">= 7.0.0"
  }
}